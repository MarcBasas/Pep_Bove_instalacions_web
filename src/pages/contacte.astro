---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CircuitLines from '../components/CircuitLines.astro';
import PrivacyModal from '../components/PrivacyModal.astro';
import { t, routes, type Lang } from '../i18n';

const lang: Lang = 'ca';
const dict = t(lang);
const page = dict.contact;
const c = dict.company;

// Map coordinates for C/ Sant Francesc d'Assís, 25 — 08700 Igualada (Barcelona)
const MAP_LAT = 41.583038;
const MAP_LNG = 1.621140;
const MAP_ZOOM = 17;
const mapsLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${c.name}, ${c.address}, ${c.city}`)}`;
---

<Base lang={lang} title={page.title} description={page.metaDesc} current="contact" altPath={routes.es.contact}>
  <!-- HERO -->
  <section class="page-hero section-dark">
    <div class="container">
      <span class="eyebrow">{page.hero.eyebrow}</span>
      <h1>{page.hero.title}</h1>
      <p class="lead">{page.hero.subtitle}</p>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="section has-circuit">
    <CircuitLines tone="light" />
    <div class="container about-grid">
      <div>
        <span class="eyebrow">{page.about.eyebrow}</span>
        <h2>{page.about.title}</h2>
      </div>
      <div>
        <p class="lead">{page.about.body1}</p>
        <p>{page.about.body2}</p>
      </div>
    </div>
  </section>

  <!-- INFO + FORM -->
  <section class="section section-alt has-circuit">
    <CircuitLines tone="light" />
    <div class="container contact-grid">
      <aside class="info">
        <h2>{page.form.title}</h2>
        <ul class="info-list">
          <li>
            <span class="info-icon"><Icon name="phone" size={20} /></span>
            <div>
              <span class="info-label">{page.info.phoneLabel}</span>
              <a href={`tel:${c.phoneRaw}`}>{c.phone}</a>
            </div>
          </li>
          <li>
            <span class="info-icon"><Icon name="mail" size={20} /></span>
            <div>
              <span class="info-label">{page.info.emailLabel}</span>
              <a href={`mailto:${c.email}`}>{c.email}</a>
            </div>
          </li>
          <li>
            <span class="info-icon"><Icon name="pin" size={20} /></span>
            <div>
              <span class="info-label">{page.info.addressLabel}</span>
              <span>{c.address}<br />{c.postalCode} {c.city} ({c.region})</span>
            </div>
          </li>
          <li>
            <span class="info-icon"><Icon name="clock" size={20} /></span>
            <div>
              <span class="info-label">{page.info.hoursLabel}</span>
              <span>{page.info.hoursValue}</span>
            </div>
          </li>
        </ul>
      </aside>

      <form class="form" method="post" action="#">
        <div class="row-2">
          <label>
            <span>{page.form.name}</span>
            <input type="text" name="name" required />
          </label>
          <label>
            <span>{page.form.surname}</span>
            <input type="text" name="surname" />
          </label>
        </div>
        <div class="row-2">
          <label>
            <span>{page.form.phone}</span>
            <input type="tel" name="phone" />
          </label>
          <label>
            <span>{page.form.email}</span>
            <input type="email" name="email" required />
          </label>
        </div>
        <label>
          <span>{page.form.subject}</span>
          <input type="text" name="subject" />
        </label>
        <label>
          <span>{page.form.message}</span>
          <textarea name="message" rows="6" required></textarea>
        </label>
        <label class="consent">
          <input type="checkbox" name="consent" required />
          <span>
            {page.form.consentBefore}<button type="button" class="consent-link" data-open-privacy>{page.form.consentLink}</button>
          </span>
        </label>
        <button class="btn btn-primary" type="submit">
          {page.form.submit}
          <Icon name="arrow" size={18} />
        </button>
      </form>
    </div>
  </section>

  <!-- MAP -->
  <section class="map-section">
    <div
      id="contact-map"
      class="map-canvas"
      role="img"
      aria-label={`Mapa: ${c.name}, ${c.address}, ${c.city}`}
      data-lat={MAP_LAT}
      data-lng={MAP_LNG}
      data-zoom={MAP_ZOOM}
      data-popup={`<strong>${c.name}</strong><br>${c.address}<br>${c.postalCode} ${c.city}<br><a href="${mapsLink}" target="_blank" rel="noopener">Veure a Google Maps</a>`}
      data-lenis-prevent
    ></div>
  </section>

  <PrivacyModal lang={lang} />
</Base>

<style>
  .page-hero {
    padding-block: clamp(4rem, 6vw, 6rem);
    position: relative;
    overflow: hidden;
  }
  .page-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(at 30% 40%, rgba(45, 129, 247, 0.22), transparent 60%);
  }
  .page-hero .container { position: relative; max-width: 800px; }
  .page-hero h1 { color: #fff; margin-bottom: 1rem; }
  .page-hero .lead { color: #CBD5E1; font-size: 1.15rem; }

  .has-circuit { position: relative; overflow: hidden; isolation: isolate; }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 4rem;
    align-items: start;
  }

  .lead {
    font-size: 1.15rem;
    line-height: 1.7;
  }

  /* CONTACT */
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 3rem;
    align-items: start;
  }

  .info h2 {
    margin-bottom: 2rem;
  }

  .info-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .info-list li {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .info-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: var(--color-primary);
    color: #fff;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }

  .info-list div {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .info-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .info-list a, .info-list span {
    color: var(--color-text);
    font-weight: 500;
  }

  /* FORM */
  .form {
    background: #fff;
    padding: 2.5rem;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .row-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .form label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .form input,
  .form textarea {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
    color: var(--color-text);
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    transition: border-color var(--transition), box-shadow var(--transition);
    background: #fff;
  }

  .form input:focus,
  .form textarea:focus {
    outline: 0;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(45, 129, 247, 0.15);
  }

  .form textarea {
    resize: vertical;
    min-height: 120px;
  }

  .consent {
    flex-direction: row;
    align-items: flex-start;
    align-self: flex-start;
    text-align: left;
    gap: 0.6rem;
    text-transform: none;
    letter-spacing: 0;
    font-weight: 400;
    font-size: 0.9rem;
    color: var(--color-text-soft);
  }

  .consent input {
    width: 18px;
    height: 18px;
    margin-top: 3px;
    accent-color: var(--color-primary);
    padding: 0;
    flex-shrink: 0;
  }

  .consent-link {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    color: var(--color-primary);
    text-decoration: underline;
    cursor: pointer;
  }

  .consent-link:hover {
    color: var(--color-primary-dark);
  }

  .form button {
    align-self: flex-start;
  }

  /* MAP */
  .map-section {
    height: 420px;
    overflow: hidden;
    background: #c9ddf9;
  }

  .map-canvas {
    width: 100%;
    height: 100%;
  }

  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .row-2 {
      grid-template-columns: 1fr;
    }
    .form {
      padding: 1.75rem;
    }
  }
</style>

<script>
  import maplibregl from 'maplibre-gl';
  import 'maplibre-gl/dist/maplibre-gl.css';

  const el = document.getElementById('contact-map');
  if (el) {
    const lat = parseFloat(el.dataset.lat || '0');
    const lng = parseFloat(el.dataset.lng || '0');
    const zoom = parseInt(el.dataset.zoom || '15', 10);
    const popupHtml = el.dataset.popup || '';

    // Brand-aligned vector-tile style
    const BRAND = '#2D81F7';
    const BRAND_DARK = '#1E5FB8';
    const TEXT_DARK = '#1E293B';
    const TEXT_SOFT = '#475569';
    const BUILDING = '#CBD5E1';
    const BUILDING_OUTLINE = '#94A3B8';
    const WATER = '#DDE7F2';
    const PARK = '#E8EFE4';
    const BG = '#F8FAFC';
    const HALO = '#FFFFFF';

    const map = new maplibregl.Map({
      container: el,
      center: [lng, lat],
      zoom,
      attributionControl: { compact: true },
      style: {
        version: 8,
        glyphs: 'https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf',
        sources: {
          openmaptiles: {
            type: 'vector',
            url: 'https://tiles.openfreemap.org/planet',
          },
        },
        layers: [
          { id: 'bg', type: 'background', paint: { 'background-color': BG } },
          {
            id: 'park',
            type: 'fill',
            source: 'openmaptiles',
            'source-layer': 'park',
            paint: { 'fill-color': PARK },
          },
          {
            id: 'water',
            type: 'fill',
            source: 'openmaptiles',
            'source-layer': 'water',
            paint: { 'fill-color': WATER },
          },
          {
            id: 'building',
            type: 'fill',
            source: 'openmaptiles',
            'source-layer': 'building',
            minzoom: 13,
            paint: {
              'fill-color': BUILDING,
              'fill-outline-color': BUILDING_OUTLINE,
              'fill-opacity': 0.85,
            },
          },
          {
            id: 'road-minor',
            type: 'line',
            source: 'openmaptiles',
            'source-layer': 'transportation',
            filter: ['in', 'class', 'minor', 'service', 'residential', 'path', 'track'],
            paint: {
              'line-color': BRAND,
              'line-opacity': 0.55,
              'line-width': ['interpolate', ['linear'], ['zoom'], 12, 0.4, 16, 2.5, 20, 6],
            },
          },
          {
            id: 'road-secondary',
            type: 'line',
            source: 'openmaptiles',
            'source-layer': 'transportation',
            filter: ['in', 'class', 'tertiary', 'secondary'],
            paint: {
              'line-color': BRAND,
              'line-opacity': 0.85,
              'line-width': ['interpolate', ['linear'], ['zoom'], 8, 0.6, 16, 4, 20, 9],
            },
          },
          {
            id: 'road-primary',
            type: 'line',
            source: 'openmaptiles',
            'source-layer': 'transportation',
            filter: ['in', 'class', 'primary', 'trunk', 'motorway'],
            paint: {
              'line-color': BRAND_DARK,
              'line-width': ['interpolate', ['linear'], ['zoom'], 6, 0.8, 16, 5, 20, 12],
            },
          },
          {
            id: 'road-label',
            type: 'symbol',
            source: 'openmaptiles',
            'source-layer': 'transportation_name',
            minzoom: 14,
            layout: {
              'text-field': ['get', 'name:latin'],
              'text-font': ['Noto Sans Regular'],
              'text-size': 11,
              'symbol-placement': 'line',
            },
            paint: {
              'text-color': TEXT_SOFT,
              'text-halo-color': HALO,
              'text-halo-width': 1.5,
            },
          },
          {
            id: 'place-label',
            type: 'symbol',
            source: 'openmaptiles',
            'source-layer': 'place',
            layout: {
              'text-field': ['get', 'name:latin'],
              'text-font': ['Noto Sans Bold'],
              'text-size': ['interpolate', ['linear'], ['zoom'], 6, 11, 14, 14],
            },
            paint: {
              'text-color': TEXT_DARK,
              'text-halo-color': HALO,
              'text-halo-width': 1.5,
            },
          },
        ],
      },
    });

    map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');

    map.on('load', () => {
      const markerEl = document.createElement('div');
      markerEl.className = 'brand-marker';
      markerEl.innerHTML = '<span class="brand-marker__pin"></span>';

      new maplibregl.Marker({ element: markerEl, anchor: 'bottom' })
        .setLngLat([lng, lat])
        .setPopup(new maplibregl.Popup({ offset: 28, closeButton: false }).setHTML(popupHtml))
        .addTo(map);
    });
  }
</script>

<style is:global>
  .brand-marker {
    width: 28px;
    height: 36px;
    cursor: pointer;
  }
  .brand-marker__pin {
    display: block;
    width: 22px;
    height: 22px;
    border-radius: 50% 50% 50% 0;
    background: #2D81F7;
    border: 3px solid #fff;
    box-shadow: 0 4px 10px rgba(15, 23, 42, 0.3);
    transform: rotate(-45deg);
    position: relative;
    left: 3px;
    top: 5px;
  }
  .maplibregl-popup-content {
    font-family: inherit;
    font-size: 0.9rem;
    line-height: 1.5;
    border-radius: 8px;
    padding: 0.85rem 1rem;
  }
  .maplibregl-popup-content a {
    color: #2D81F7;
    font-weight: 600;
  }
</style>
